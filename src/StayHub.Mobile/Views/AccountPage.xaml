<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayHub.Mobile.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Account">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="24">
            <VerticalStackLayout Spacing="4">
                <Label Text="Account" Style="{StaticResource PageTitle}" />
                <Label x:Name="RoleLabel" Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ManagementSection" Spacing="10" IsVisible="False">
                <Label Text="Management" Style="{StaticResource SectionTitle}" />

                <Border x:Name="UsersRow" Style="{StaticResource Card}" Padding="16,18" IsVisible="False">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnUsersTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Label Text="👥" FontSize="22" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="User management" FontFamily="OpenSansSemibold" FontSize="16" />
                            <Label Text="Manage team access and roles" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="28" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border x:Name="SynchronizationRow" Style="{StaticResource Card}" Padding="16,18" IsVisible="False">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSynchronizationTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Label Text="↻" FontSize="26" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Synchronization" FontFamily="OpenSansSemibold" FontSize="16" />
                            <Label Text="Run and inspect PMS synchronization" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="28" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Button
                Text="Sign out"
                Clicked="OnLogoutClicked"
                Margin="0,12,0,0"
                HeightRequest="64"
                BackgroundColor="Transparent"
                BorderColor="#E56B75"
                BorderWidth="1"
                CornerRadius="14"
                TextColor="#E56B75"
                FontFamily="OpenSansSemibold"
                FontSize="17" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
