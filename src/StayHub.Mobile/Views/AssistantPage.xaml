<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayHub.Mobile.Views.AssistantPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:StayHub.Mobile.Models"
    Title="AI">

    <Grid
        x:Name="PageLayout"
        Padding="20,12,20,104"
        RowDefinitions="Auto,*"
        RowSpacing="16"
        SafeAreaEdges="Container,SoftInput">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border
                WidthRequest="48"
                HeightRequest="48"
                Padding="0"
                BackgroundColor="#34B7C9"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24">
                <Label
                    Text="✦"
                    FontSize="26"
                    TextColor="White"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />
            </Border>

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="1"
                VerticalOptions="Center">
                <Label
                    Text="StayHub AI"
                    FontAttributes="Bold"
                    FontSize="22" />
                <Label
                    Text="Your operations assistant"
                    Style="{StaticResource Caption}" />
            </VerticalStackLayout>
        </Grid>

        <Grid
            Grid.Row="1"
            RowDefinitions="*,Auto"
            RowSpacing="12">

            <Grid>
                <CollectionView
                    x:Name="MessagesView"
                    ItemsSource="{Binding Messages}"
                    SelectionMode="None"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    HorizontalScrollBarVisibility="Never">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout
                            Orientation="Vertical"
                            ItemSpacing="4" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AssistantMessageViewModel">
                            <Border
                                Margin="0,4"
                                MaximumWidthRequest="350"
                                Padding="16,12"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                HorizontalOptions="Start"
                                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">

                                <Border.Triggers>
                                    <DataTrigger
                                        TargetType="Border"
                                        Binding="{Binding IsUser}"
                                        Value="True">
                                        <Setter Property="HorizontalOptions" Value="End" />
                                        <Setter Property="BackgroundColor" Value="#16849A" />
                                        <Setter Property="Stroke" Value="#35AFC2" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Label
                                    Text="{Binding Content}"
                                    FontSize="16"
                                    LineHeight="1.18"
                                    LineBreakMode="WordWrap">
                                    <Label.Triggers>
                                        <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding IsUser}"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <VerticalStackLayout
                    x:Name="EmptyState"
                    Spacing="14"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center">
                    <Label
                        Text="How can I help?"
                        FontAttributes="Bold"
                        FontSize="24"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="Ask about arrivals, departures, guests or bookings"
                        Style="{StaticResource Caption}"
                        HorizontalTextAlignment="Center" />

                    <Border
                        Margin="0,10,0,0"
                        Padding="14,11"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeShape="RoundRectangle 18">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNextArrivalSuggestionClicked" />
                        </Border.GestureRecognizers>
                        <Label Text="Who is arriving next?  →" />
                    </Border>

                    <Border
                        Padding="14,11"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeShape="RoundRectangle 18">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTodayDeparturesSuggestionClicked" />
                        </Border.GestureRecognizers>
                        <Label Text="Who is checking out today?  →" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Border
                Grid.Row="1"
                Padding="6,4,5,4"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#292929}"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 28">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry
                        x:Name="QuestionEntry"
                        Margin="8,0,0,0"
                        BackgroundColor="Transparent"
                        Placeholder="Message StayHub AI"
                        ReturnType="Send"
                        VerticalOptions="Center"
                        Focused="OnQuestionEntryFocused"
                        Unfocused="OnQuestionEntryUnfocused"
                        Completed="OnSendClicked" />

                    <Grid
                        Grid.Column="1"
                        WidthRequest="48"
                        HeightRequest="48">
                        <Button
                            x:Name="SendButton"
                            WidthRequest="48"
                            HeightRequest="48"
                            Padding="0"
                            CornerRadius="24"
                            FontAttributes="Bold"
                            FontSize="24"
                            Text="↑"
                            SemanticProperties.Description="Send message"
                            Clicked="OnSendClicked" />

                        <ActivityIndicator
                            x:Name="SendingIndicator"
                            IsVisible="False"
                            IsRunning="False"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
