<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayHub.Mobile.Views.TodayPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:StayHub.Mobile.Models"
    Title="Today">

    <ContentPage.Resources>
        <DataTemplate x:Key="BookingTemplate" x:DataType="models:DashboardBookingOverview">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        CommandParameter="{Binding Id}"
                        Tapped="OnBookingTapped" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5" ColumnSpacing="10">
                    <Label Text="{Binding GuestName}" Style="{StaticResource SectionTitle}" />
                    <Border Grid.Column="1" BackgroundColor="{Binding StatusColor}" StrokeThickness="0"
                            StrokeShape="RoundRectangle 10" Padding="9,5">
                        <Label Text="{Binding StatusLabel}" TextColor="White" FontSize="11" FontFamily="OpenSansSemibold" />
                    </Border>
                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PropertyName}" Style="{StaticResource Caption}" />
                    <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="7">
                        <Label Text="{Binding ArrivalDate, StringFormat='{0:dd MMM}'}" />
                        <Label Text="→" Style="{StaticResource Caption}" />
                        <Label Text="{Binding DepartureDate, StringFormat='{0:dd MMM}'}" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>

    </ContentPage.Resources>

    <Grid>
        <RefreshView x:Name="DashboardRefreshView" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="20,16,20,24" Spacing="20">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Today" Style="{StaticResource PageTitle}" />
                        <Label Text="{Binding Dashboard.BusinessDate, StringFormat='Operations for {0:dddd, dd MMMM}'}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Arrivals" Style="{StaticResource SectionTitle}" />
                            <Label Grid.Column="1" Text="{Binding Dashboard.Arrivals.TotalCount}" Style="{StaticResource Caption}" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dashboard.Arrivals.Items}"
                                             BindableLayout.ItemTemplate="{StaticResource BookingTemplate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Departures" Style="{StaticResource SectionTitle}" />
                            <Label Grid.Column="1" Text="{Binding Dashboard.Departures.TotalCount}" Style="{StaticResource Caption}" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dashboard.Departures.Items}"
                                             BindableLayout.ItemTemplate="{StaticResource BookingTemplate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="In house" Style="{StaticResource SectionTitle}" />
                            <Label Grid.Column="1" Text="{Binding Dashboard.InHouse.TotalCount}" Style="{StaticResource Caption}" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dashboard.InHouse.Items}"
                                             BindableLayout.ItemTemplate="{StaticResource BookingTemplate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Upcoming arrivals" Style="{StaticResource SectionTitle}" />
                            <Label Grid.Column="1" Text="{Binding Dashboard.UpcomingArrivals.TotalCount}" Style="{StaticResource Caption}" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dashboard.UpcomingArrivals.Items}"
                                             BindableLayout.ItemTemplate="{StaticResource BookingTemplate}" />
                    </VerticalStackLayout>

                    <Border
                        Style="{StaticResource Card}"
                        Stroke="{Binding SynchronizationStatusColor}"
                        Padding="16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSynchronizationStatusTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Label
                                Text="!"
                                TextColor="{Binding SynchronizationStatusColor}"
                                FontFamily="OpenSansSemibold"
                                FontSize="20"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                WidthRequest="28" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{Binding SynchronizationStatusTitle}" FontFamily="OpenSansSemibold" FontSize="16" />
                                <Label Text="{Binding SynchronizationStatusDetail}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="2"
                                Text="›"
                                FontSize="28"
                                Style="{StaticResource Caption}"
                                VerticalOptions="Center"
                                IsVisible="{Binding HasSynchronizationAlerts}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <ActivityIndicator x:Name="LoadingIndicator" IsVisible="False" IsRunning="False"
                           Color="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />

        <VerticalStackLayout x:Name="ErrorPanel" IsVisible="False" Spacing="12"
                             HorizontalOptions="Center" VerticalOptions="Center" Padding="24">
            <Label x:Name="ErrorLabel" HorizontalTextAlignment="Center" Style="{StaticResource Caption}" />
            <Button Text="Try again" Clicked="OnRetryClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
