<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayHub.Mobile.Views.SynchronizationAlertsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:StayHub.Mobile.Models"
    Title="Sync issues">

    <CollectionView ItemsSource="{Binding Alerts}" SelectionMode="None" Margin="20,16,20,24">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="4" Margin="0,0,0,20">
                <Label Text="Synchronization issues" Style="{StaticResource PageTitle}" />
                <Label Text="Recent synchronization runs that need attention" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:SynchronizationAlertOverview">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Stroke="#B3261E">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding SourceName}" Style="{StaticResource SectionTitle}" />
                            <Label Grid.Column="1" Text="{Binding Status}" TextColor="#B3261E" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <Label Text="{Binding Summary}" Style="{StaticResource Caption}" />
                        <Label Text="{Binding ErrorMessage}" LineBreakMode="WordWrap" />
                        <Label Text="{Binding StartedAtUtc, StringFormat='Started {0:dd MMM, HH:mm} UTC'}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
