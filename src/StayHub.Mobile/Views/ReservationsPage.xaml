<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayHub.Mobile.Views.ReservationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:StayHub.Mobile.Models"
    Title="Reservations">

    <Grid Padding="20,16" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <VerticalStackLayout Spacing="4">
            <Label Text="Reservations" Style="{StaticResource PageTitle}" />
            <Label Text="Upcoming arrivals across all properties" Style="{StaticResource Caption}" />
        </VerticalStackLayout>

        <SearchBar Grid.Row="1" Placeholder="Search guest or property" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Reservations}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ReservationOverview">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
                            <Label Text="{Binding GuestName}" Style="{StaticResource SectionTitle}" />
                            <Border Grid.Column="1" BackgroundColor="{Binding StatusColor}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="9,5">
                                <Label Text="{Binding Status}" TextColor="White" FontSize="11" FontFamily="OpenSansSemibold" />
                            </Border>
                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PropertyName}" Style="{StaticResource Caption}" />
                            <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="7">
                                <Label Text="{Binding ArrivalDate, StringFormat='{0:dd MMM}'}" />
                                <Label Text="→" Style="{StaticResource Caption}" />
                                <Label Text="{Binding DepartureDate, StringFormat='{0:dd MMM}'}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
