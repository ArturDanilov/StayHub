<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayHub.Mobile.Views.ReservationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:StayHub.Mobile.Models"
    Title="Bookings">

    <Grid Padding="20,16,20,10" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="4">
                <Label Text="Bookings" Style="{StaticResource PageTitle}" />
                <Label x:Name="SummaryLabel" Text="Live data from StayHub API" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
            <Border Grid.Column="1" BackgroundColor="{StaticResource Secondary}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12,7" VerticalOptions="Center">
                <Label x:Name="CountLabel" Text="0" TextColor="{StaticResource Tertiary}" FontFamily="OpenSansSemibold" />
            </Border>
        </Grid>

        <HorizontalStackLayout
            Grid.Row="1"
            Spacing="10">
            <Button
                x:Name="FilterToggleButton"
                Text="⌕"
                FontSize="26"
                WidthRequest="54"
                HeightRequest="48"
                Padding="0"
                SemanticProperties.Description="Open search and filters"
                Clicked="OnFiltersClicked" />

            <Button
                x:Name="AddReservationButton"
                Text="+"
                FontSize="28"
                WidthRequest="54"
                HeightRequest="48"
                Padding="0"
                IsVisible="False"
                SemanticProperties.Description="Add booking"
                Clicked="OnAddReservationClicked" />
        </HorizontalStackLayout>

        <Border
            x:Name="FilterPanel"
            Grid.Row="2"
            IsVisible="False"
            Padding="16"
            BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
            StrokeShape="RoundRectangle 20">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label
                        Text="⌕"
                        FontSize="24"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center" />
                    <Entry
                        x:Name="SearchEntry"
                        Grid.Column="1"
                        Placeholder="Guest, property or booking ID"
                        PlaceholderColor="{StaticResource Gray300}"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        BackgroundColor="Transparent"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Status" Style="{StaticResource Caption}" />
                        <Picker x:Name="StatusPicker" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Property" Style="{StaticResource Caption}" />
                        <Picker x:Name="PropertyPicker" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Source" Style="{StaticResource Caption}" />
                        <Picker x:Name="SourcePicker" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Sort" Style="{StaticResource Caption}" />
                        <Picker x:Name="SortPicker" />
                    </VerticalStackLayout>
                </Grid>

                <Label x:Name="FilterErrorLabel" IsVisible="False" TextColor="#FF6B6B" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Clear" Clicked="OnClearFiltersClicked" />
                    <Button Grid.Column="1" Text="Apply" Clicked="OnApplyFiltersClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="3">
            <RefreshView x:Name="ReservationsRefreshView" Refreshing="OnRefreshing" VerticalOptions="Fill">
                <CollectionView x:Name="ReservationsCollection" ItemsSource="{Binding Reservations}"
                                SelectionMode="None"
                                VerticalOptions="Fill" VerticalScrollBarVisibility="Always">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ReservationOverview">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        CommandParameter="{Binding .}"
                                        Tapped="OnReservationTapped" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="10">
                                    <Label Text="{Binding GuestName}" Style="{StaticResource SectionTitle}" />
                                    <Border Grid.Column="1" BackgroundColor="{Binding StatusColor}" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10" Padding="9,5" HorizontalOptions="End">
                                        <Label Text="{Binding StatusLabel}" TextColor="White" FontSize="11" FontFamily="OpenSansSemibold" />
                                    </Border>
                                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PropertyName}" Style="{StaticResource Caption}" />
                                    <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="7">
                                        <Label Text="{Binding ArrivalDate, StringFormat='{0:dd MMM}'}" />
                                        <Label Text="→" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding DepartureDate, StringFormat='{0:dd MMM}'}" />
                                    </HorizontalStackLayout>
                                    <Label Grid.Row="3" Text="{Binding SourceName}" Style="{StaticResource Caption}" />
                                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding ExternalId}" Style="{StaticResource Caption}"
                                           HorizontalTextAlignment="End" LineBreakMode="TailTruncation" MaximumWidthRequest="150" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
            <ActivityIndicator x:Name="LoadingIndicator" IsVisible="False" IsRunning="False" Color="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
            <VerticalStackLayout x:Name="ErrorPanel" IsVisible="False" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                <Label x:Name="ErrorLabel" HorizontalTextAlignment="Center" Style="{StaticResource Caption}" />
                <Button Text="Try again" Clicked="OnRetryClicked" />
            </VerticalStackLayout>
            <Label x:Name="EmptyLabel" IsVisible="False" Text="No matching bookings." Style="{StaticResource Caption}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <Grid
            x:Name="PaginationPanel"
            Grid.Row="4"
            ColumnDefinitions="*,Auto,*"
            ColumnSpacing="12"
            HeightRequest="44"
            IsVisible="False">

            <Button
                x:Name="PreviousButton"
                Text="Previous"
                Clicked="OnPreviousClicked" />

            <Label
                x:Name="PageLabel"
                Grid.Column="1"
                Text="Page 1"
                VerticalOptions="Center"
                HorizontalTextAlignment="Center"
                MinimumWidthRequest="80" />

            <Button
                x:Name="NextButton"
                Grid.Column="2"
                Text="Next"
                Clicked="OnNextClicked" />
        </Grid>
    </Grid>
</ContentPage>
