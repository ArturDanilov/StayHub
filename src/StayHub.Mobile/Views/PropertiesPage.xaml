<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayHub.Mobile.Views.PropertiesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:StayHub.Mobile.Models"
    Title="Properties">

    <Grid Padding="20,16" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <VerticalStackLayout Spacing="4">
            <Label Text="Your properties" Style="{StaticResource PageTitle}" />
            <Label Text="A quick overview of your portfolio" Style="{StaticResource Caption}" />
        </VerticalStackLayout>

        <Border Grid.Row="1" BackgroundColor="{StaticResource Tertiary}" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="18">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <VerticalStackLayout>
                    <Label Text="3" FontSize="30" FontFamily="OpenSansSemibold" TextColor="White" />
                    <Label Text="Properties" TextColor="#D6EEF2" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="6" FontSize="30" FontFamily="OpenSansSemibold" TextColor="White" />
                    <Label Text="Upcoming stays" TextColor="#D6EEF2" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Properties}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PropertyOverview">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5">
                            <Label Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                            <Label Grid.Row="1" Text="{Binding Location}" Style="{StaticResource Caption}" />
                            <Label Grid.Row="2" Text="{Binding UpcomingReservations, StringFormat='{0} upcoming reservations'}" Style="{StaticResource Caption}" />
                            <Border Grid.Column="1" Grid.RowSpan="3" BackgroundColor="{StaticResource Secondary}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,6" VerticalOptions="Center">
                                <Label Text="{Binding Occupancy}" TextColor="{StaticResource Tertiary}" FontSize="12" FontFamily="OpenSansSemibold" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
