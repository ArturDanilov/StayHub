<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StayHub.Mobile.Views.PropertiesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:StayHub.Mobile.Models"
    Title="Properties">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Logout" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <Grid Padding="20,16" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <VerticalStackLayout Spacing="4">
            <Label Text="Your properties" Style="{StaticResource PageTitle}" />
            <Label Text="Live data from StayHub API" Style="{StaticResource Caption}" />
        </VerticalStackLayout>

        <Border Grid.Row="1" BackgroundColor="{StaticResource Tertiary}" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="18">
            <VerticalStackLayout>
                <Label x:Name="PropertyCountLabel" Text="0" FontSize="30" FontFamily="OpenSansSemibold" TextColor="White" />
                <Label Text="Properties" TextColor="#D6EEF2" />
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="2">
            <RefreshView
                x:Name="PropertiesRefreshView"
                Refreshing="OnRefreshing">
                <CollectionView
                    x:Name="PropertiesCollection"
                    ItemsSource="{Binding Properties}"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PropertyOverview">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                                    <Label Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                                    <Label Grid.Row="1" Text="{Binding Location}" Style="{StaticResource Caption}" />
                                    <Label Grid.Row="2" Text="{Binding CreatedLabel}" Style="{StaticResource Caption}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsVisible="False"
                IsRunning="False"
                Color="{StaticResource Primary}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <VerticalStackLayout
                x:Name="ErrorPanel"
                IsVisible="False"
                Spacing="12"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Label x:Name="ErrorLabel" HorizontalTextAlignment="Center" Style="{StaticResource Caption}" />
                <Button Text="Try again" Clicked="OnRetryClicked" />
            </VerticalStackLayout>

            <Label
                x:Name="EmptyLabel"
                IsVisible="False"
                Text="No properties found."
                Style="{StaticResource Caption}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
