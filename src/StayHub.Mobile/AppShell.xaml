<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="StayHub.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="StayHub">

    <TabBar>
        <ShellContent
            x:Name="TodayContent"
            Icon="today.svg"
            Title="Today"
            Route="Today" />

        <ShellContent
            x:Name="PropertiesContent"
            Icon="properties.svg"
            Title="Properties"
            Route="Properties" />

        <ShellContent
            x:Name="AssistantContent"
            Icon="assistant.svg"
            Title="AI"
            Route="Assistant" />

        <ShellContent
            x:Name="ReservationsContent"
            Icon="reservations.svg"
            Title="Bookings"
            Route="Reservations" />

        <ShellContent
            x:Name="AccountContent"
            Icon="users.svg"
            Title="Account"
            Route="Account" />
    </TabBar>

</Shell>
