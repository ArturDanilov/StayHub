<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="StayHub.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="StayHub">

    <TabBar>
        <ShellContent
            x:Name="TodayContent"
            Title="Today"
            Route="Today" />

        <ShellContent
            x:Name="PropertiesContent"
            Title="Properties"
            Route="Properties" />

        <ShellContent
            x:Name="ReservationsContent"
            Title="Bookings"
            Route="Reservations" />

        <ShellContent
            x:Name="AssistantContent"
            Title="AI"
            Route="Assistant" />

        <ShellContent
            x:Name="SynchronizationContent"
            Title="Sync"
            Route="Synchronization" />

        <ShellContent
            x:Name="UsersContent"
            Title="Users"
            Route="Users" />
    </TabBar>

</Shell>
