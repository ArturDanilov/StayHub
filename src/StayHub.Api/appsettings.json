{
  "DatabaseInitialization": {
    "ApplyMigrations": true
  },
  "SeedData": {
    "DemoDataEnabled": false
  },
  "Swagger": {
    "Enabled": false
  },
  "AutomaticSynchronization": {
    "Enabled": false,
    "IntervalMinutes": 720,
    "InitialDelaySeconds": 60,
    "SourceNames": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
